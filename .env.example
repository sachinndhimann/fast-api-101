# Copy to .env and adjust
DATABASE_URL=postgresql+asyncpg://fastapi101:fastapi101@localhost:5432/fastapi101
SYNC_DATABASE_URL=postgresql://fastapi101:fastapi101@localhost:5432/fastapi101
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ENV=development
